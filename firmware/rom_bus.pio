; EXPERIMENTAL. No guaranteed cartridge timing. Disabled in default firmware.
; GPIO0..14 address, 16..23 data, 24 /RD; side-set GPIO28 VALID.
.program rom_bus
.side_set 1
.wrap_target
    wait 0 gpio 24 side 0
    mov isr, null side 0
    in pins, 15 side 0
    push block side 0
    pull block side 0
    out pins, 8 side 0
    nop side 0
    nop side 1
    wait 1 gpio 24 side 1
    nop side 0
.wrap
